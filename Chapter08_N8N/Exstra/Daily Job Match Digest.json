              "type": "string",
              "value": "pune,Mumbai, banglore"
            },
            {
              "id": "a3",
              "name": "recipient",
              "type": "string",
              "value": "sandipgarje1997@gmail.com"
            }
          ]
        },
        "options": {}
      },
      "id": "f6962a62-5c4a-41c2-abfb-3cd044666a35",
      "name": "Search Settings",
