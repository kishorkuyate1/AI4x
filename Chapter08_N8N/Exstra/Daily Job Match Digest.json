      "typeVersion": 3.4,
      "position": [
        272,
        224
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "queries",
              "type": "array",
              "value": "={{ [\"linkedin.com/jobs\", \"naukri.com\", \"in.indeed.com\"].map(site => \"site:\" + site + \" \" + $json.jobTitle + \" \" + $json.location) }}"
