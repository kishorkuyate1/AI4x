        },
        "options": {}
      },
      "id": "2e2549f5-085c-42cd-b5aa-bda2af42d57b",
      "name": "Download My CV",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        800,
        224
      ],
      "executeOnce": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "E2gq2QgADYJ5qffu",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "id": "62068572-290b-4f5c-bd9f-8fe2e0a366cd",
      "name": "Read CV Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        1024,
        224
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=MY CV:\n{{ $json.text }}\n\nTARGET ROLE: {{ $(\"Search Settings\").first().json.jobTitle }} in {{ $(\"Search Settings\").first().json.location }}\n\nJOB SEARCH RESULTS (JSON):\n{{ JSON.stringify($(\"Collect All Jobs\").first().json.jobs) }}",
        "options": {
          "systemMessage": "You are a job-matching assistant. From the search results, keep only real individual job postings (skip category pages, login pages and duplicates). Score each against the CV from 0-100 based on skills, experience and location fit. Return ONLY an HTML email body (no markdown, no code fences): a short intro line, then a table of the top 10 matches sorted by score with columns Score, Job Title, Company (if known), Platform (LinkedIn/Naukri/Indeed), a one-line reason, and an Apply link using the posting URL. If nothing relevant was found, say so in one sentence."
        }
      },
      "id": "25c02d76-67f1-4d18-8410-e85e57276a6d",
      "name": "Rank Jobs Against CV",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1280,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "540aeee6-d5c3-4daa-8260-3af7d213bfee",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1360,
        224
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $(\"Search Settings\").first().json.recipient }}",
        "subject": "=Your job matches for {{ $now.toFormat(\"dd LLL yyyy\") }}",
        "message": "={{ $json.output }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "29698332-3476-45e8-be95-c7fded818c49",
      "name": "Email Job Digest",
